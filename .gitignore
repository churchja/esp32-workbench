# Flash images are megabytes of binary per board. The manifest is the record
# that matters and IS tracked -- it says what was backed up, when, and its hash.
backups/**/*.bin
backups/**/dump/
!backups/**/manifest.json

# Build outputs. NOTE both framework conventions -- an earlier version listed
# only .pio/ (PlatformIO) and the ESP-IDF migration silently made
# projects/*/build/ committable: 97MB across 3244 files, including 4MB mbedTLS
# archives and a 3MB ELF.
.pio/
projects/*/.pio/
build/
projects/*/build/
managed_components/
projects/*/managed_components/

# Generated per-target by `idf.py set-target`; sdkconfig.defaults is the
# tracked source of truth. Known-good fragments live in
# templates/idf-base/examples/.
sdkconfig
sdkconfig.old
projects/*/sdkconfig
projects/*/sdkconfig.old

.scratch/
.scratch_build/
.smoke_idf/
projects/_validate/
*.bak
__pycache__/
.DS_Store
.scratch_build/

# Archify diagram evidence. The .json specs ARE tracked -- they are the source,
# and `archify deliver` regenerates the HTML from them. The visual-check PNGs
# and receipts are re-derivable browser evidence (~1.4MB per run) that churn on
# every regeneration, so they follow the same rule as backups/**/*.bin: keep the
# record that says what was checked, not the bytes it was checked against.
docs/diagrams/*.visual-check.*
